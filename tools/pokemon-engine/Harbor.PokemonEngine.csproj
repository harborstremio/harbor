<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors><AssemblyName>Harbor.PokemonEngine</AssemblyName></PropertyGroup>
  <ItemGroup><Compile Remove="fixtures/**/*.cs" /><ProjectReference Include="$(PKForgeRoot)/src/PKForge.Engine/PKForge.Engine.csproj" /></ItemGroup>
  <Target Name="RequireEngineSource" BeforeTargets="PrepareForBuild"><Error Condition="'$(PKForgeRoot)' == ''" Text="Build with the pinned PKForge source path: -p:PKForgeRoot=..." /></Target>
</Project>
