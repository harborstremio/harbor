{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "retro-player",
  "description": "Local Harbor retro host window; isolated emulator frames receive no IPC permissions.",
  "windows": ["harbor-retro"],
  "permissions": [
    "core:default", "core:window:allow-close", "core:window:allow-destroy",
    "core:window:allow-show", "core:window:allow-set-focus", "core:window:allow-unminimize",
    "core:window:allow-is-fullscreen", "core:window:allow-set-fullscreen",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://github.com/EmulatorJS/EmulatorJS/**" }] }
  ]
}
