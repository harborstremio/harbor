{
  "manifest_version": 3,
  "name": "Harbor Stream Blocker",
  "version": "1.0.0",
  "description": "Local ad request filters for Twitch and Kick, with TwitchAdSolutions playlist filtering.",
  "permissions": [
    "declarativeNetRequest"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.twitch.tv/*"
      ],
      "js": [
        "twitch-vaft.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "provider_ads",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "key": ""
}
