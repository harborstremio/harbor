      "title": "Fortnite",
      "productKind": "Game",
      "images": {
        "boxArt": {
          "url": "https://store-images.s-microsoft.com/image/apps.20392.70702278257994163.6d75301b-59c3-4a73-b70c-5901ae9cbb44.24e2eab9-1b75-4157-ba8b-006f4624d839",
