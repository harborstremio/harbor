<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The app fetches playlists, EPG, metadata, and streams over the network. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- Voice search: the mic captures speech for the speech-to-text engine. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- Chromecast: the Cast SDK's media-notification foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>

    <!-- Android TV: declare leanback so the TV launcher lists the app, and make
         both leanback and touchscreen optional so it also installs on phones and
         tablets (one responsive codebase across all six targets). -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false"/>
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false"/>

    <application
        android:label="Harbor"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:banner="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- App Shortcuts (long-press launcher) + Google Assistant surface. -->
            <meta-data
              android:name="android.app.shortcuts"
              android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <!-- Lists the app in the Android TV (leanback) home launcher. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
            <!-- Deep links: stremio:// open/install links and harbor:// installer
                 links open in Harbor and route to the detail or addon installer. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="stremio"/>
                <data android:scheme="harbor"/>
            </intent-filter>
        </activity>
        <!-- Chromecast: the Cast framework reads the receiver/options provider
             from this metadata (the flutter_chrome_cast default provider, which
             uses the Default Media Receiver). Only consulted when the app first
             initializes CastContext, which it does lazily on a sender platform. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.felnanuke.google_cast.GoogleCastOptionsProvider" />

        <!-- Disable Impeller (Flutter's default Vulkan/GLES renderer): it
             SIGSEGV-crashes at launch on many real Android TV GPUs/drivers
             (Mali / older Amlogic, no proper Vulkan), and a corrupted Vulkan
             pipeline cache then crashes every subsequent launch. Falling back to
             Skia keeps the app compatible across cheap TV hardware (e.g. Mi TV).
             The emulator's GPU hides this, which is why it only crashed on the
             real device. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Voice search: resolve the on-device speech recognition service
             (required for visibility under Android 11+ package visibility). -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>
</manifest>
