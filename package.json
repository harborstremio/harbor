{
  "name": "harbor",
  "version": "0.9.124",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "vp check",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:settings": "node scripts/check-settings.mjs",
    "check:search": "node scripts/check-settings-search.mjs",
    "check:tvstrings": "node scripts/check-tv-strings.mjs",
    "check:tvstrings:wide": "node scripts/check-tv-strings.mjs --list-wide",
    "check:tvinvariants": "node scripts/check-tv-invariants.mjs",
    "check:tvresources": "node scripts/check-tv-resources.mjs",
    "check:orphanstrings": "node scripts/orphan-strings.mjs",
    "tauri": "tauri",
    "tauri:build:linux-system": "tauri build --config src-tauri/tauri.linux-system.conf.json",
    "build:tv": "tsc -b && vite build --mode android",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --apk --target aarch64",
    "setup": "npm run setup:binaries && npm run setup:libmpv && npm run setup:mpv && npm run setup:fonts",
    "setup:binaries": "node scripts/fetch-binaries.mjs",
    "setup:libmpv": "node scripts/fetch-libmpv.mjs",
    "setup:mpv": "node scripts/fetch-mpv.mjs",
    "setup:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "setup:fonts": "node scripts/fetch-fonts.mjs",
    "setup:all": "node scripts/fetch-libmpv.mjs && node scripts/fetch-mpv.mjs && node scripts/fetch-ffmpeg.mjs && node scripts/fetch-fonts.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "node --experimental-loader ./scripts/node-test-loader.mjs --test tests/*.test.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "@rive-app/canvas": "^2.41.0",
    "@tanstack/react-virtual": "^3.14.6",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "^2.5.8",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "fflate": "^0.8.3",
    "flag-icons": "^7.5.0",
    "gifenc": "^1.0.3",
    "hls.js": "^1.6.16",
    "lottie-web": "^5.13.0",
    "lucide-react": "^0.460.0",
    "mpegts.js": "^1.8.0",
    "onnxruntime-web": "1.27.0",
    "parse-torrent-title": "^3.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "cheerio": "^1.2.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-static-copy": "^2.0.0"
  },
  "packageManager": "pnpm@11.9.0"
}
